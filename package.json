{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Production-quality real-time messaging platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "cloudflare"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:local": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "test:smoke": "node scripts/full-smoke-test.js",
    "test:e2e-media": "node scripts/test-e2e-media.mjs",
    "test:e2e-media-integration": "node scripts/e2e-media-integration-test.mjs",
    "test:games": "npx tsx scripts/test-game-engines.ts",
    "test:game-hardening": "npx tsx scripts/test-game-hardening.ts",
    "test:pulse-play": "node scripts/pulse-play-smoke.mjs",
    "test:malware": "node scripts/test-malware-scan.mjs",
    "ci": "npm run typecheck && npm run lint && npm run build && npm run test:e2e-media && npm run test:games && npm run test:game-hardening && npm run test:malware",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "npm install && node scripts/setup-env.js",
    "cf:deploy": "npx wrangler deploy",
    "cf:dev": "npx wrangler dev",
    "cf:secret": "npx wrangler secret put"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
