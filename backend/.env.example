NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://localhost:27017/pulse
JWT_ACCESS_SECRET=your_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5050
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=52428800
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Pulse <noreply@pulse.app>
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# ── Scaling (optional) ────────────────────────────────────────────────
# Set to run more than one API instance. Enables the Socket.IO Redis adapter
# and the cross-instance presence mirror. Unset = single-instance mode.
REDIS_URL=
# Identifies this replica in presence snapshots; defaults to hostname-pid.
INSTANCE_ID=

# ── Observability ─────────────────────────────────────────────────────
# error | warn | info | debug. Defaults to info in production, debug otherwise.
LOG_LEVEL=
# Production logs are JSON by default; set "pretty" for human-readable lines.
LOG_FORMAT=
# Required to scrape GET /api/metrics in production (404s without it).
METRICS_TOKEN=
# Requests slower than this are logged at warn level.
SLOW_REQUEST_MS=1500
